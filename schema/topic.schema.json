{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tt-sensei.github.io/jp-learning-taxonomy/schema/topic.schema.json",
  "title": "JP Learning Taxonomy Topic",
  "type": "object",
  "required": [
    "id",
    "subject",
    "domain",
    "name",
    "description",
    "grades",
    "topicType",
    "evidence",
    "curriculumStandards",
    "prerequisiteIds",
    "resourceIds",
    "reviewStatus",
    "studentName",
    "studentDescription",
    "gradePlacement"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]+$"
    },
    "subject": {
      "type": "string",
      "minLength": 1
    },
    "domain": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "grades": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 6
      },
      "uniqueItems": true
    },
    "topicType": {
      "enum": [
        "concept",
        "skill",
        "practice",
        "expression",
        "appreciation",
        "inquiry",
        "attitude",
        "experience",
        "other",
        "application"
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "sourceId",
          "note"
        ],
        "properties": {
          "sourceId": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "curriculumStandards": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "prerequisiteIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "resourceIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reviewStatus": {
      "enum": [
        "draft",
        "needs-review",
        "reviewed",
        "published"
      ]
    },
    "topicLifecycle": {
      "enum": [
        "active",
        "superseded"
      ],
      "description": "Optional lifecycle state. Omission means active."
    },
    "replacementTopicIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "description": "Successor topic IDs when topicLifecycle is superseded."
    },
    "studentName": {
      "type": "string",
      "minLength": 1,
      "description": "Child-facing display title. The stable internal taxonomy name remains in name."
    },
    "studentDescription": {
      "type": "string",
      "minLength": 1,
      "description": "Child-facing explanation in direct, accessible Japanese."
    },
    "cluster": {
      "type": "string",
      "minLength": 1,
      "description": "Optional project-specific cluster for grouping related topic candidates."
    },
    "gradePlacement": {
      "type": "object",
      "required": [
        "status",
        "candidateFirstIntroductionGrade",
        "candidateContinuingGrades",
        "basis",
        "note"
      ],
      "properties": {
        "status": {
          "enum": [
            "candidate",
            "needs-review",
            "reviewed",
            "verified"
          ]
        },
        "candidateFirstIntroductionGrade": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6
        },
        "candidateContinuingGrades": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 6
          },
          "uniqueItems": true
        },
        "basis": {
          "type": "string",
          "minLength": 1
        },
        "note": {
          "type": "string"
        },
        "sourceUrl": {
          "type": "string",
          "format": "uri"
        }
      },
      "additionalProperties": false,
      "description": "Candidate placement and its evidence status; this is not automatically an official grade assignment."
    },
    "conceptualPillarCandidates": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "粒子",
          "エネルギー",
          "生命",
          "地球"
        ]
      },
      "uniqueItems": true,
      "description": "Optional project-specific science conceptual-pillar candidates; not an official curriculum code."
    },
    "officialAreaCandidate": {
      "type": "string",
      "minLength": 1,
      "description": "Optional editorially assigned official-area candidate or explicit note that the topic is crosscutting."
    }
  },
  "additionalProperties": false
}
