        {
          "label": "小数と分数を対応させる",
          "grades": "3〜5年ごろ",
          "topicIds": [
            "jp.elem.math.decimals-tenths",
            "jp.elem.math.decimal-fraction-tenths",
            "jp.elem.math.decimal-fraction-numberline",
            "jp.elem.math.decimal-fraction-equivalence",
            "jp.elem.math.decimal-place-value"
          ]
        },
        {
          "label": "分数・小数の計算へ",
          "grades": "4〜6年ごろ",
          "topicIds": [
            "jp.elem.math.decimal-add-subtract",
