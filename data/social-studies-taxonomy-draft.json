      },
      {
        "id": "history",
        "label": "歴史的な見方・考え方",
        "note": "時期・推移・比較、出来事の背景や意味を捉える観点。"
      },
      {
        "id": "civics",
        "label": "社会的な見方・考え方（政治・公民）",
        "note": "制度や仕組み、社会への関わり、選択・判断を捉える観点。"
      },
      {
        "id": "inquiry",
        "label": "社会的事象の調べ方・まとめ方",
        "note": "地図・統計・年表・写真・聞き取り等を使う横断的な技能。"
      }
    ],
    "caution": "観点はプロジェクトの横断分類であり、公式の学年別内容項目や公式コードと同一ではない。"
  },
