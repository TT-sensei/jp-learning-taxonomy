  "reviewPlan": [
    {
      "id": "framework",
      "label": "公式の学年別内容と教科構造",
      "status": "partial-review",
      "note": "初期案で第3学年に置いていた「地域の発展に尽くした先人」は、再照合により第4学年内容（4）「県内の伝統や文化，先人の働き」に対応する候補として修正。第3学年内容（3）「地域の安全を守る働き」に対応する消防・警察の候補学年も第3学年に修正。"
    },
    {
      "id": "coverage",
      "label": "学習項目の網羅性と粒度",
      "status": "partial-review",
      "note": "第4学年の県内の特色ある地域の説明範囲を具体化し、第5学年内容（5）の自然災害・国土保全に関する候補項目を追加。第6学年の歴史・国際理解の範囲を説明文に明記。各内容への詳細な照合とコード確認は継続する。"
    },
    {
      "id": "grade-placement",
      "label": "学年配当と地域教材の扱い",
      "status": "needs-review",
      "note": "候補学年を公式解説と照合し、地域によって具体例が異なる点を分離する。"
    },
    {
      "id": "official-codes",
      "label": "公式コード",
      "status": "not-started",
      "note": "公式コード表の実データと照合するまで推測登録しない。"
    },
    {
      "id": "relationships",
      "label": "前提・関連・発展の関係",
      "status": "not-started",
      "note": "公式の系統とプロジェクト独自の学習上のつながりを分けて設計する。"
    },
    {
      "id": "sources",
      "label": "出典・表現・利用条件",
      "status": "needs-review",
      "note": "公式資料の要約にとどめ、出典と確認状態を記録する。"
    }
